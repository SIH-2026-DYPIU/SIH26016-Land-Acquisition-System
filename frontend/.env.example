# Default: demo authentication screen.
# Set to "api" when the Spring Boot authentication endpoint is ready.
VITE_AUTH_MODE=demo

# Firebase configuration (required for Firebase authentication)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave empty when using the Vite /api proxy.
# For direct backend calls, use:
# VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=
